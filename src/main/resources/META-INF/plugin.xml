<idea-plugin package="io.github.dsudomoin.koraplugin">
    <id>io.github.dsudomoin.kora-plugin</id>
    <name>Kora Support</name>
    <vendor>dsudomoin</vendor>

    <description><![CDATA[
        Provides Spring-like "Go to Declaration" navigation for the Kora DI framework.
        Navigate from dependency injection points (constructor parameters, factory method parameters)
        to their providers (@Component classes, factory methods in @KoraApp/@Module interfaces).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="hocon-support.xml">org.jetbrains.plugins.hocon</depends>
    <depends optional="true" config-file="sql-support.xml">com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="io.github.dsudomoin.koraplugin.index.KoraProviderIndex"/>
        <fileBasedIndex implementation="io.github.dsudomoin.koraplugin.index.KoraInjectionSiteIndex"/>

        <gotoDeclarationHandler order="first"
                implementation="io.github.dsudomoin.koraplugin.config.yaml.YamlConfigGotoHandler"/>
        <gotoDeclarationHandler order="first"
                implementation="io.github.dsudomoin.koraplugin.config.AnnotationValueGotoHandler"/>
        <codeInsight.lineMarkerProvider language="JAVA" order="last"
                implementationClass="io.github.dsudomoin.koraplugin.navigation.KoraLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin" order="last"
                implementationClass="io.github.dsudomoin.koraplugin.navigation.KoraLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA" order="last"
                implementationClass="io.github.dsudomoin.koraplugin.config.ConfigSourceLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin" order="last"
                implementationClass="io.github.dsudomoin.koraplugin.config.ConfigSourceLineMarkerProvider"/>

        <localInspection
                language="UAST"
                groupName="Kora Framework"
                shortName="KoraMissingProvider"
                displayName="Missing Kora DI provider"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="io.github.dsudomoin.koraplugin.inspection.KoraMissingProviderInspection"/>

        <completion.contributor language="yaml"
                implementationClass="io.github.dsudomoin.koraplugin.config.yaml.KoraYamlCompletionContributor"/>

        <localInspection
                language="yaml"
                groupName="Kora Framework"
                shortName="KoraUnknownConfigKey"
                displayName="Unknown Kora config key"
                enabledByDefault="false"
                level="WEAK WARNING"
                implementationClass="io.github.dsudomoin.koraplugin.inspection.KoraUnknownConfigKeyInspection"/>

        <platform.backend.documentation.targetProvider
                implementation="io.github.dsudomoin.koraplugin.query.KoraQueryMacroDocumentationProvider"/>

        <psi.symbolReferenceProvider
                hostLanguage="JAVA"
                hostElementClass="com.intellij.psi.PsiLiteralExpression"
                targetClass="io.github.dsudomoin.koraplugin.query.KoraQueryMacroSymbol"
                implementationClass="io.github.dsudomoin.koraplugin.query.KoraQueryMacroSymbolReferenceProvider"/>
        <psi.symbolReferenceProvider
                hostLanguage="kotlin"
                hostElementClass="org.jetbrains.kotlin.psi.KtStringTemplateExpression"
                targetClass="io.github.dsudomoin.koraplugin.query.KoraQueryMacroSymbol"
                implementationClass="io.github.dsudomoin.koraplugin.query.KoraQueryMacroSymbolReferenceProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.modules.ultimate">
        <dependencySupport kind="java"
                coordinate="ru.tinkoff.kora:kora-common"
                displayName="Kora"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
